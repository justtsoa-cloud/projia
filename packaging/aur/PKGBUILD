# Maintainer: RANIRIAMANJAKA Antsa <antsa.raniriamanjaka@univ-antananarivo.mg>
pkgname=projia-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Assistant IA gratuit qui choisit le meilleur modèle gratuit et bascule quand un quota est atteint"
arch=('x86_64')
url="https://github.com/justtsoa-cloud/projia"
license=('Apache-2.0')
depends=('fuse2' 'gtk3' 'libsecret')
provides=('projia')
conflicts=('projia')
options=('!strip' '!debug')
source=("Projia-${pkgver}-x86_64.AppImage::${url}/releases/download/v${pkgver}/Projia-${pkgver}-x86_64.AppImage"
        "projia.desktop::https://raw.githubusercontent.com/justtsoa-cloud/projia/v${pkgver}/packaging/flatpak/io.github.raantss18.projia.desktop"
        "projia.png::https://raw.githubusercontent.com/justtsoa-cloud/projia/v${pkgver}/docs/brand/projia-icon-512.png")
noextract=("Projia-${pkgver}-x86_64.AppImage")
# Sommes à recopier depuis SHA256SUMS de la release (makepkg -g pour les autres).
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "Projia-${pkgver}-x86_64.AppImage" "${pkgdir}/opt/projia/Projia.AppImage"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /opt/projia/Projia.AppImage "${pkgdir}/usr/bin/projia"
  sed 's|^Exec=.*|Exec=projia|; s|^Icon=.*|Icon=projia|' projia.desktop > projia.fixed.desktop
  install -Dm644 projia.fixed.desktop "${pkgdir}/usr/share/applications/projia.desktop"
  install -Dm644 projia.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/projia.png"
}
